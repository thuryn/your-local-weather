<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer 3D Drop Shadow -->
    <item
        android:left="2dp"
        android:top="5dp"
        android:right="2dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#70000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- Main Outer 3D Glass Container -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#401E293B"
                android:endColor="#200F172A"
                android:type="linear" />
            <corners android:radius="26dp" />
            <stroke
                android:width="2dp"
                android:color="#6038BDF8" />
        </shape>
    </item>
</layer-list>
