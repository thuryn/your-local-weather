<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <SwitchPreference
        android:defaultValue="false"
        android:key="notification_pref_key"
        android:title="@string/pref_title_notification"/>
    <ListPreference
        android:defaultValue="when_updated"
        android:dialogTitle="@string/pref_title_notification_presence"
        android:entries="@array/notification_presence_entries"
        android:entryValues="@array/notification_presence_values"
        android:key="notification_presence_pref_key"
        android:title="@string/pref_title_notification_presence"/>
    <ListPreference
        android:defaultValue="icon_sun"
        android:dialogTitle="@string/pref_title_notification_status_icon"
        android:entries="@array/notification_status_icon_entries"
        android:entryValues="@array/notification_status_icon_values"
        android:key="notification_status_icon_pref_key"
        android:title="@string/pref_title_notification_status_icon"/>
    <ListPreference
        android:defaultValue="build_in"
        android:dialogTitle="@string/pref_title_notification_visual_style"
        android:entries="@array/notification_visual_style_entries"
        android:entryValues="@array/notification_visual_style_values"
        android:key="notification_visual_style_pref_key"
        android:title="@string/pref_title_notification_visual_style"/>
    <ListPreference
        android:defaultValue="60"
        android:dialogTitle="@string/pref_title_notification_refresh_interval"
        android:entries="@array/notification_refresh_intervals_entries"
        android:entryValues="@array/notification_refresh_interval_values"
        android:key="notification_interval_pref_key"
        android:title="@string/pref_title_notification_refresh_interval"/>
    <SwitchPreference
        android:defaultValue="false"
        android:key="notification_vibrate_pref_key"
        android:title="@string/pref_title_vibrate"/>
    <PreferenceCategory
        android:title="@string/pref_category_notification_forecast_filter">
        <SwitchPreference
            android:defaultValue="false"
            android:key="notification_forecast_condition_enabled_pref_key"
            android:summary="@string/pref_summary_notification_forecast_condition_enabled"
            android:title="@string/pref_title_notification_forecast_condition_enabled"/>
        <MultiSelectListPreference
            android:defaultValue="@array/notification_forecast_conditions_defaults"
            android:dialogTitle="@string/pref_title_notification_forecast_conditions"
            android:entries="@array/notification_forecast_conditions_entries"
            android:entryValues="@array/notification_forecast_conditions_values"
            android:key="notification_forecast_conditions_pref_key"
            android:title="@string/pref_title_notification_forecast_conditions"/>
        <ListPreference
            android:defaultValue="6"
            android:dialogTitle="@string/pref_title_notification_forecast_lookahead"
            android:entries="@array/notification_forecast_lookahead_entries"
            android:entryValues="@array/notification_forecast_lookahead_values"
            android:key="notification_forecast_lookahead_hours_pref_key"
            android:title="@string/pref_title_notification_forecast_lookahead"/>
        <ListPreference
            android:defaultValue="10"
            android:dialogTitle="@string/pref_title_notification_forecast_wind_threshold"
            android:entries="@array/notification_forecast_wind_threshold_entries"
            android:entryValues="@array/notification_forecast_wind_threshold_values"
            android:key="notification_forecast_wind_threshold_pref_key"
            android:title="@string/pref_title_notification_forecast_wind_threshold"/>
        <ListPreference
            android:defaultValue="180"
            android:dialogTitle="@string/pref_title_notification_forecast_cooldown"
            android:entries="@array/notification_forecast_cooldown_entries"
            android:entryValues="@array/notification_forecast_cooldown_values"
            android:key="notification_forecast_cooldown_minutes_pref_key"
            android:title="@string/pref_title_notification_forecast_cooldown"/>
        <SwitchPreference
            android:defaultValue="false"
            android:key="notification_forecast_quiet_hours_enabled_pref_key"
            android:summary="@string/pref_summary_notification_forecast_quiet_hours_enabled"
            android:title="@string/pref_title_notification_forecast_quiet_hours_enabled"/>
        <ListPreference
            android:defaultValue="22"
            android:dialogTitle="@string/pref_title_notification_forecast_quiet_hours_start"
            android:entries="@array/notification_forecast_quiet_hours_entries"
            android:entryValues="@array/notification_forecast_quiet_hours_values"
            android:key="notification_forecast_quiet_hours_start_pref_key"
            android:title="@string/pref_title_notification_forecast_quiet_hours_start"/>
        <ListPreference
            android:defaultValue="7"
            android:dialogTitle="@string/pref_title_notification_forecast_quiet_hours_end"
            android:entries="@array/notification_forecast_quiet_hours_entries"
            android:entryValues="@array/notification_forecast_quiet_hours_values"
            android:key="notification_forecast_quiet_hours_end_pref_key"
            android:title="@string/pref_title_notification_forecast_quiet_hours_end"/>
    </PreferenceCategory>
</PreferenceScreen>